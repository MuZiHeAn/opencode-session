[Unit]
Description=opencode-session local proxy
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/opencode-session --listen 127.0.0.1:18777 --upstream https://opencode.ai/zen/go/v1 --log-level info
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
